#include <iostream>
#include <deque>
#include <list>
#include <cstdlib>
#include <ctime>
#include <conio.h>
#include <windows.h>
#include "proceso.hpp"

using namespace std;

// Constantes de memoria según rúbrica (en KB)
enum TamanioMemoriaFijo {
    _1MB = 1024,
    _4MB = 4096,
    _8MB = 8192
};

// Algoritmos asignados al equipo
enum AlgoritmosMemoria {
    PRIMER_AJUSTE = 1,
    BUDDY_SYSTEM = 2
};

// Variables de control de simulación
bool parar = false;
bool pausa = false;
bool esperandoMemoria = false;
Proceso* procesoEsperando = nullptr;

// Parámetros configurables
int quantumSistema = 0;
int tamanoMaxProceso = 0;
int quantumMaxProceso = 0;
int tamanoMemoriaFijo = 0;
int velocidadMs = 1000;
AlgoritmosMemoria algoritmoSeleccionado;

// Variables para el Módulo de Estadísticas
int totalProcesosAtendidos = 0;
int totalCiclosEjecutados = 0;
long long sumaTiempoAtencion = 0;
double sumaPorcentajeOcupacion = 0.0;
int desperdicioQuantumTotal = 0;

// Prototipos de funciones definidas en simulador.cpp
void MostrarMemoria(const list<Proceso>& memoriaProcesos);
void SleepInterruptible(int milisegundos);
void EjecutarRR(deque<Proceso>& colaProcesos, list<Proceso>& memoriaProcesos);
bool AsignarMemoria(list<Proceso>& memoriaProcesos, Proceso& p);
double CalcularOcupacionActual(const list<Proceso>& memoriaProcesos);
void MostrarEstadisticasFinales();

int main() {
    srand(time(NULL));
    deque<Proceso> colaProcesos;

    cout << "=====================================================" << endl;
    cout << "  SIMULADOR DE MEMORIA Y PLANIFICACION ROUND ROBIN   " << endl;
    cout << "     (Primer Ajuste / Buddy System + Round Robin)    " << endl;
    cout << "=====================================================" << endl << endl;

    // 1. Configuración de memoria fija
    cout << "Seleccione el tamanio fijo de la memoria (1: 1MB, 2: 4MB, 3: 8MB): ";
    int tamanoInput;
    cin >> tamanoInput;
    switch (tamanoInput) {
        case 1: tamanoMemoriaFijo = _1MB; break;
        case 2: tamanoMemoriaFijo = _4MB; break;
        case 3: tamanoMemoriaFijo = _8MB; break;
        default:
            cout << "Opcion no valida. Usando 4MB (4096 KB) por defecto." << endl;
            tamanoMemoriaFijo = _4MB;
            break;
    }

    // 2. Configuración de parámetros del sistema
    cout << "Ingrese el quantum del sistema: ";
    cin >> quantumSistema;
    while (quantumSistema <= 0) {
        cout << "El quantum debe ser mayor a 0: ";
        cin >> quantumSistema;
    }

    cout << "Ingrese el tamanio maximo de memoria por proceso (1 - " << tamanoMemoriaFijo << " KB): ";
    cin >> tamanoMaxProceso;
    while (tamanoMaxProceso <= 0 || tamanoMaxProceso > tamanoMemoriaFijo) {
        cout << "Tamanio invalido. Ingrese un valor entre 1 y " << tamanoMemoriaFijo << " KB: ";
        cin >> tamanoMaxProceso;
    }

    cout << "Ingrese el quantum maximo por proceso: ";
    cin >> quantumMaxProceso;
    while (quantumMaxProceso <= 0) {
        cout << "El quantum maximo por proceso debe ser mayor a 0: ";
        cin >> quantumMaxProceso;
    }

    // 3. Selección de algoritmo
    cout << "Seleccione el algoritmo de colocacion (1: Primer Ajuste, 2: Buddy System): ";
    int algInput;
    cin >> algInput;
    while (algInput != 1 && algInput != 2) {
        cout << "Opcion no valida. Ingrese 1 (Primer Ajuste) o 2 (Buddy System): ";
        cin >> algInput;
    }
    algoritmoSeleccionado = (algInput == 1) ? PRIMER_AJUSTE : BUDDY_SYSTEM;

    // 4. Control de velocidad
    cout << "Ingrese la velocidad de simulacion en milisegundos (ej. 500 = rapido, 1500 = lento): ";
    cin >> velocidadMs;
    if (velocidadMs < 50) velocidadMs = 50;

    // Inicialización de memoria
    Proceso memoriaInicial(tamanoMemoriaFijo);
    list<Proceso> memoriaProcesos = { memoriaInicial };

    cout << "\nControles durante la ejecucion:" << endl;
    cout << "  [ESPACIO] Pausar / Reanudar" << endl;
    cout << "  [+] / [-] Aumentar / Disminuir velocidad" << endl;
    cout << "  [ESC]     Terminar simulacion y ver estadisticas" << endl << endl;

    cout << "Salida Inicial: ";
    MostrarMemoria(memoriaProcesos);
    cout << endl << endl;

    Proceso* p = nullptr;
    int numeroCiclo = 1;

    while (!parar) {
        if (_kbhit()) {
            char tecla = _getch();
            if (tecla == 27) { // ESC
                parar = true;
                break;
            }
        }

        cout << "------------------- CICLO " << numeroCiclo << " -------------------" << endl;

        // 1. Generación aleatoria o recuperación del proceso en espera
        if (!esperandoMemoria) {
            p = new Proceso();
            int tiempoEjecucion = rand() % quantumMaxProceso + 1;
            int tamano = rand() % tamanoMaxProceso + 1;
            p->setTiempoEjecucion(tiempoEjecucion);
            p->setTamanioProceso(tamano);
        } else {
            p = procesoEsperando;
        }

        // 2. Intentar asignar memoria al proceso listo
        if (AsignarMemoria(memoriaProcesos, *p)) {
            cout << "Entra Proceso " << *p << endl;
            colaProcesos.push_back(*p);

            if (esperandoMemoria) {
                delete procesoEsperando;
                procesoEsperando = nullptr;
                esperandoMemoria = false;
            } else {
                delete p;
                p = nullptr;
            }
        } else {
            cout << "Proceso en espera (sin espacio suficiente): " << *p << endl;
            if (!esperandoMemoria) {
                procesoEsperando = p;
                esperandoMemoria = true;
            }
        }

        // Mostrar estado de memoria tras intentar inserción
        MostrarMemoria(memoriaProcesos);
        cout << endl;

        // 3. Ejecutar Round Robin
        if (!colaProcesos.empty()) {
            EjecutarRR(colaProcesos, memoriaProcesos);
        } else {
            cout << "Cola RR vacia." << endl;
        }

        // 4. Impresión final del ciclo
        cout << "Estado final de memoria: ";
        MostrarMemoria(memoriaProcesos);
        cout << endl << endl;

        // Acumular ocupación para estadísticas
        sumaPorcentajeOcupacion += CalcularOcupacionActual(memoriaProcesos);
        totalCiclosEjecutados++;
        numeroCiclo++;

        SleepInterruptible(velocidadMs);
    }

    if (procesoEsperando != nullptr) {
        delete procesoEsperando;
        procesoEsperando = nullptr;
    }

    MostrarEstadisticasFinales();
    return 0;
}
